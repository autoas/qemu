r"""
set LL_DL=64
scons --cpl=QemuVersatilepbGCC --app=VersatilepbFlashDriver
scons --cpl=QemuVersatilepbGCC --app=VersatilepbCanApp
scons --cpl=QemuVersatilepbGCC --app=VersatilepbCanBL
build\nt\GCC\Loader\Loader.exe -a build\nt\QemuVersatilepbGCC\VersatilepbCanApp\VersatilepbCanApp.s19 -s 1043456
build\nt\GCC\Loader\Loader.exe -f build\nt\QemuVersatilepbGCC\VersatilepbFlashDriver\VersatilepbFlashDriver.s19 -s 4096

scons --cpl=QemuVersatilepbGCC --app=VersatilepbCanBLRun
build\nt\GCC\Loader\Loader.exe -a build\nt\QemuVersatilepbGCC\VersatilepbCanApp\VersatilepbCanApp.s19.sign -f build\nt\QemuVersatilepbGCC\VersatilepbFlashDriver\VersatilepbFlashDriver.s19.sign -l %LL_DL%

qemu-system-arm.exe -m 128 -M versatilepb -kernel build/nt/QemuVersatilepbGCC/VersatilepbCanBL/VersatilepbCanBL.exe -serial stdio -serial tcp:127.0.0.1:9000,server

# DoIP over the SMSC 91C111 ethernet controller emulated by QEMU
scons --cpl=QemuVersatilepbGCC --app=VersatilepbDoIPBL --net=LWIP
scons --cpl=QemuVersatilepbGCC --app=VersatilepbDoIPBLRun
set AS_LOCAL_IP=127.0.0.1
build\nt\GCC\Loader\Loader.exe -d DOIP.127.0.0.1 -p 13400 -c FBL -S crc16 -f build\nt\QemuVersatilepbGCC\VersatilepbFlashDriver\VersatilepbFlashDriver.s19.sign -a build\nt\QemuVersatilepbGCC\VersatilepbCanApp\VersatilepbCanApp.s19.sign
"""


from building import *


@register_compiler
def CompilerQemuVersatilepbGCC(**kwargs):
    env = CreateCompiler("ArmGCC")
    return env


for sc in Glob("*/SConscript"):
    SConscript(sc)

CWD = GetCurrentDir()

Import("BUILD_DIR")

ApplicationCanBL = query_application("CanBL")

objsKey = Glob("%s/app/platform/simulator/src/Key.c" % (RootDir))
objsOta = Glob("%s/app/platform/simulator/src/ota.c" % (RootDir))

objs = Glob("*/*.c")

objsAsm = Glob("*/*.S")

objsPci = Glob("bsp/pci/*.c")

objsApp = Glob("../../../app/main.c") + Glob("../../../app/src/*.c")


libsForVersatilepbCanApp = {
    "CanNm": Glob("config/Com/CanNm.json"),
    "CanSM": Glob("config/Com/CanSM.json"),
    "Com": Glob("config/Com/Com.json"),
    "ComM": Glob("config/Com/ComM.json"),
    "Nm": Glob("config/Com/Nm.json"),
    "CanTp": Glob("config/CanTp/CanTp.json"),
    "PduR": Glob("config/Com/PduR.json"),
    "CanIf": Glob("config/Com/CanIf.json"),
    "Dcm": Glob("config/Dcm/Dcm.json"),
    "Xcp": Glob("config/Xcp/Xcp.json"),
    "RoD": Glob("config/RoD/RoD.json") + Glob("config/RoD/*.c"),
}

Os_Cfg = Glob("config/OS/Os.json")

BL_Cfg = Glob("config/BL/BL.json")


@register_library
class LibraryVersatilepb(Library):
    def config(self):
        self.include = "%s/bsp" % (CWD)
        self.Append(CPPDEFINES=["OS_TICKS_PER_SECOND=100"])
        self.LIBS = ["QemuArmInt", "gcc"]
        self.CPPPATH = ["$INFRAS"]
        self.source = objs


@register_application
class ApplicationVersatilepbCanBL(ApplicationCanBL):
    compiler = "QemuVersatilepbGCC"

    def platform_config(self):
        self.LIBS += ["Versatilepb", "LibC"]
        self.Append(CPPDEFINES=["USE_STD_DEBUG", "USE_STD_PRINTF"])
        self.RegisterConfig("BL", BL_Cfg, force=True)
        self.Append(CPPDEFINES=["CANTP_CFG_N_Cr=5000"])
        self.Append(CPPFLAGS=["-mcpu=arm926ej-s", "-marm"])
        self.Append(ASFLAGS=["-mcpu=arm926ej-s", "-marm"])
        self.Append(LINKFLAGS=["-T", "%s/linker-boot.lds" % (CWD), "-Map", "%s/VersatilepbCanBL.map" % (BUILD_DIR)])
        appObj = "%s/../VersatilepbCanApp/VersatilepbCanApp.o" % (BUILD_DIR)
        self.source += [appObj] + objsAsm + objsOta


flsObjs = Glob("../flash/*.c")


@register_application
class ApplicationVersatilepbFlashDriver(Application):
    compiler = "QemuVersatilepbGCC"

    def signit(self):
        sign = os.path.abspath("%s/../../GCC/Loader/Loader" % (BUILD_DIR))
        if IsPlatformWindows():
            sign += ".exe"
        if os.path.isfile(sign):
            target = "%s/VersatilepbFlashDriver" % (BUILD_DIR)
            s19T = target + ".s19"
            cmd = "%s -f %s -s 4096" % (sign, s19T)
            self.AddPostAction(cmd)

    def config(self):
        self.CPPPATH = ["$INFRAS"]
        self.Append(CPPDEFINES=["FLS_START_ADDRESS=0x00040000", "FLS_END_ADDRESS=0x00140000"])
        self.Append(CPPFLAGS=["-mcpu=arm926ej-s", "-marm"])
        self.Append(ASFLAGS=["-mcpu=arm926ej-s", "-marm"])
        self.Append(
            LINKFLAGS=["-T", "%s/linker-flsdrv.lds" % (CWD), "-Map", "%s/VersatilepbFlashDriver.map" % (BUILD_DIR)]
        )
        self.source = flsObjs
        self.signit()


@register_application
class ApplicationVersatilepbCanBLRun(Application):
    def config(self):
        pass

    def build(self):
        qemu = Qemu(arch="arm", CAN0=True)
        target = "%s/VersatilepbCanBL" % (BUILD_DIR[:-3])
        if IsPlatformWindows():
            target = target + ".exe"
        qemu.Run("-m 128 -M versatilepb -kernel %s" % (target))


@register_application
class ApplicationVersatilepbCanApp(Application):
    compiler = "QemuVersatilepbGCC"

    def signit(self):
        sign = os.path.abspath("%s/../../GCC/Loader/Loader" % (BUILD_DIR))
        if IsPlatformWindows():
            sign += ".exe"
        if os.path.isfile(sign):
            target = "%s/VersatilepbCanApp" % (BUILD_DIR)
            s19T = target + ".s19"
            cmd = "%s -a %s -s 0x3FE80 -S crc16-v3" % (sign, s19T)
            self.AddPostAction(cmd)
            env = self.ensure_env()
            cplPath = os.path.dirname(env["CC"])

            binT = target + ".bin"
            objT = target + ".o"
            symName = binT.replace(":", "_").replace("/", "_").replace("\\", "_").replace(".", "_")
            cmd = "%s/arm-none-eabi-objcopy -I binary -O elf32-littlearm %s %s --binary-architecture arm" % (
                cplPath,
                binT,
                objT,
            )
            self.AddPostAction(cmd)
            cmd = (
                "%s/arm-none-eabi-objcopy -I elf32-littlearm -O elf32-littlearm %s %s"
                " --rename-section .data=.app --redefine-sym _binary_%s_start=._app_start"
                " --redefine-sym _binary_%s_end=._app_end --redefine-sym _binary_%s_size=._app_size"
                % (cplPath, objT, objT, symName, symName, symName)
            )
            self.AddPostAction(cmd)

    def platform_config(self):
        self.source += objsKey
        self.LIBS += ["Versatilepb", "LibC", "OSAL", "Shell"]
        # USE_CAN is needed so that EcuM schedules the CAN driver main functions
        # (Can_MainFunction_Write/Read) and the CAN stack main functions
        # (CanIf/CanTp/Nm).  Without it the emulated serial CAN can only confirm
        # one transmission per received frame, so a multi frame response
        # (e.g. an XCP ShortUpload of more than one DTO) can never be sent.
        self.Append(CPPDEFINES=["USE_CAN", "USE_SHELL", "USE_STBM_DFT", "USE_STD_TIME_64", "USE_MCU"])
        self.Append(CPPDEFINES=["USE_STD_DEBUG", "USE_STD_PRINTF", "BL_FLSDRV_MEMORY_LOW=0x00140000"])
        self.Append(CPPFLAGS=["-mcpu=arm926ej-s", "-marm"])
        self.Append(ASFLAGS=["-mcpu=arm926ej-s", "-marm"])
        self.Append(LINKFLAGS=["-T", "%s/linker-app.lds" % (CWD), "-Map", "%s/VersatilepbCanApp.map" % (BUILD_DIR)])
        self.SelectOS(arch="arm", config=Os_Cfg, CPPDEFINES=["OS_STK_SIZE_SCALER=4", "USE_OSAL"])
        self.signit()

    def config(self):
        LL_DL = os.getenv("LL_DL")
        if LL_DL != None:
            self.Append(CPPDEFINES=["CANTP_LL_DL=%s" % (LL_DL)])
        self.CPPDEFINES = []
        self.CPPPATH = [f"{RootDir}/app/app/include", "$INFRAS", "%s/include" % (CWD), CWD, "$Com_Cfg", "$EcuM_Cfg"]
        self.LIBS = ["StdTimer", "EcuM", "MemPool"]
        for libName, source in libsForVersatilepbCanApp.items():
            self.LIBS.append(libName)
            self.RegisterConfig(libName, source)
            self.Append(CPPDEFINES=["USE_%s" % (libName.split(":")[0].upper())])
        source = self.Generate(["%s/config/OS/OsMem.json" % (CWD)])
        self.source = source["MemCluster"] + objsApp
        self.platform_config()


@register_application
class ApplicationVersatilepbCanAppRun(Application):
    def config(self):
        pass

    def build(self):
        qemu = Qemu(arch="arm", CAN0=True)
        target = "%s/VersatilepbCanApp" % (BUILD_DIR[:-3])
        if IsPlatformWindows():
            target = target + ".exe"
        qemu.Run("-m 128 -M versatilepb -kernel %s" % (target))


ApplicationBL = ApplicationCanBL.__bases__[0]

objsLWIPCfg = Glob("config/LWIP/*.c")

objsNet = Glob("bsp/net/*.c")

objsTcpIpCfg = Glob("config/TcpIp/TcpIp_Cfg.c")

libsForVersatilepbDoIPBL = {
    "BL": Glob("config/BL/BL.json"),
    "Dcm": Glob("config/Net/Dcm.json"),
    "PduR": Glob("config/Net/PduR.json"),
    # the TcpIp module itself comes from infras/communication/TcpIp/TcpIp.c unmodified, built
    # against the lwIP socket API; only its platform port is provided here
    "TcpIp": objsTcpIpCfg,
}


@register_application
class ApplicationVersatilepbDoIPBL(ApplicationBL):
    compiler = "QemuVersatilepbGCC"

    def gencfg(self):
        source = self.Generate(
            ["%s/config/Net/Network.json" % (CWD), "%s/config/Net/Mempool.json" % (CWD)]
        )
        self.libsForBL.update(
            {
                "SoAd": source["SoAd"] + source["MemCluster"],
                "DoIP": source["DoIP"],
            }
        )

    def platform_config(self):
        # The TcpIp module of infras is reused as it is (it is written against the lwIP socket
        # API); the platform only provides TcpIp_Config: the SMSC 91C111 driver + netif bring
        # up, and the main function that pumps the stack, because there is no OS and hence no
        # lwIP tcpip thread on this target (LWIP_TCPIP_CORE_LOCKING, see config/LWIP).
        # BL_RECOVERY_MODE keeps the bootloader running as a pure DoIP programming target.
        self.LIBS += ["Versatilepb", "LibC", "LWIP"]
        self.Append(
            CPPDEFINES=[
                "USE_STD_DEBUG",
                "USE_STD_PRINTF",
                "BL_RECOVERY_MODE",
            ]
        )
        self.Append(CPPFLAGS=["-mcpu=arm926ej-s", "-marm"])
        self.Append(ASFLAGS=["-mcpu=arm926ej-s", "-marm"])
        self.Append(
            LINKFLAGS=["-T", "%s/linker-boot.lds" % (CWD), "-Map", "%s/VersatilepbDoIPBL.map" % (BUILD_DIR)]
        )
        self.RegisterConfig(
            "LWIP",
            objsLWIPCfg,
            CPPPATH="%s/config/LWIP" % (CWD),
        )
        self.CPPPATH += ["%s/bsp" % (CWD), "%s/bsp/net" % (CWD)]
        self.source += objsAsm + objsNet

    def config(self):
        self.libsForBL = libsForVersatilepbDoIPBL
        self.gencfg()
        super().config()
        # the TcpIp config includes the netif and the driver header of this board
        self.RegisterConfig("TcpIp", objsTcpIpCfg, force=True, CPPPATH="%s/bsp/net" % (CWD))
        self.platform_config()


@register_application
class ApplicationVersatilepbDoIPBLRun(Application):
    def config(self):
        pass

    def build(self):
        qemu = Qemu(arch="arm")
        target = "%s/VersatilepbDoIPBL" % (BUILD_DIR[:-3])
        if IsPlatformWindows():
            target = target + ".exe"
        # both the DoIP TCP data socket and the UDP discovery socket are forwarded from the host
        # loopback to the QEMU user mode network, so that a diagnostic tester can reach the
        # bootloader: TCP for routing activation/UDS, UDP for vehicle identification.
        # The host port is the well known 13400: a unicast tester sends from an ephemeral port and
        # waits for the answer on it, so the port forward does not clash with the tester. Use
        # another host port (and the same one for the Loader's -p) if 13400 is already taken.
        qemu.Run(
            "-m 128 -M versatilepb -kernel %s"
            " -nic user,model=smc91c111"
            ",hostfwd=tcp:127.0.0.1:13400-:13400,hostfwd=udp:127.0.0.1:13400-:13400" % (target)
        )
